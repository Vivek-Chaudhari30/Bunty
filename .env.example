# Every setting and secret name the project uses, with no real values.
# Copy to .env and fill in your own values. Never commit .env.
# Inside Vellum, store secrets with `assistant credentials prompt` instead of this file.

# AI model (Claude, through Vellum's provider layer)
ANTHROPIC_API_KEY=

# AI model through AICredits (https://aicredits.in): one OpenAI-compatible key, billed in INR.
# Check it with `bun infra/scripts/check-aicredits.ts`; connect Chintu with infra/scripts/connect-aicredits.sh
AICREDITS_API_KEY=
# Defaults: https://api.aicredits.in/v1 and openai/gpt-6-luna
AICREDITS_BASE_URL=
AICREDITS_MODEL=

# Phone calls (Twilio, built into Vellum). Later.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Speech to text and text to speech (built into Vellum). Later.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs voice ids per language for calls (integrations/calls/scripts/voice-config.ts)
ELEVENLABS_VOICE_HI=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_GU=

# WhatsApp (Meta WhatsApp Cloud API, through the Vellum gateway). Later.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Google via Composio (MCP). Later.
COMPOSIO_API_KEY=

# Shared-number router (backend/router). Later.
ROUTER_WHATSAPP_APP_SECRET=
ROUTER_WHATSAPP_VERIFY_TOKEN=
ROUTER_TWILIO_AUTH_TOKEN=
ROUTER_INTERNAL_HMAC_KEY=
# Public URL Twilio and Meta call, e.g. https://router.example.com (Twilio signs this URL)
ROUTER_PUBLIC_BASE_URL=
# Sign-up page sent to unknown numbers (defaults to the website preview)
ROUTER_ONBOARDING_URL=
# Port and SQLite file (defaults 8787 and router.db)
ROUTER_PORT=
ROUTER_DB_PATH=
# Optional bearer token for the router's GET /metrics
ROUTER_METRICS_TOKEN=

# Outside services in our own code: "mock" (default, nothing leaves the machine) or "real"
BUNTY_ADAPTERS=

# Inside each assistant (plugins): its id in the router and the router's URL (outbound hints)
BUNTY_ASSISTANT_ID=
BUNTY_ROUTER_URL=
# Names other assistants see when paired (integrations/a2a-delegation), e.g. Chintu / Owner A
BUNTY_ASSISTANT_NAME=
BUNTY_OWNER_NAME=

# Notion MCP server for AI tools (shared integration key, see the collaborator setup PDF)
NOTION_TOKEN=
